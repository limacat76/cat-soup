@@ -0,0 +1,36 @@
+import openpyxl
+import pytest
+
+from fizzbuzz import export_xlsx, fizzbuzz
+
+
+def test_export_xlsx_writes_sheet(tmp_path):
+    path = tmp_path / "fizzbuzz.xlsx"
+    export_xlsx(15, path)
+
+    workbook = openpyxl.load_workbook(path)
+    assert workbook.sheetnames == ["fizzbuzz"]
+    rows = list(workbook["fizzbuzz"].iter_rows(values_only=True))
+    assert rows[0] == ("n", "output")
+    assert rows[1:] == [(n, fizzbuzz(n)) for n in range(1, 16)]
+
+
+def test_export_xlsx_rejects_zero(tmp_path):
+    with pytest.raises(ValueError):
+        export_xlsx(0, tmp_path / "fizzbuzz.xlsx")
+
+
+@pytest.mark.parametrize("limit", [2.5, "15", None])
+def test_export_xlsx_rejects_non_integer_limit(tmp_path, limit):
+    path = tmp_path / "fizzbuzz.xlsx"
+    with pytest.raises(ValueError):
+        export_xlsx(limit, path)
+    assert not path.exists()
+
+
+def test_export_xlsx_refuses_existing_path(tmp_path):
+    path = tmp_path / "fizzbuzz.xlsx"
+    path.write_bytes(b"keep me")
+    with pytest.raises(FileExistsError):
+        export_xlsx(15, path)
+    assert path.read_bytes() == b"keep me"
