+from pathlib import Path
+
+from openpyxl import Workbook
+
+from .core import fizzbuzz
+
+
+def export_xlsx(limit: int, path: str | Path) -> None:
+    """Write FizzBuzz for 1..limit to an .xlsx file, sheet `fizzbuzz`.
+
+    Raises ValueError if `limit` is not a positive integer, and FileExistsError
+    if `path` already exists; in both cases nothing is written.
+    """
+    if not isinstance(limit, int) or limit < 1:
+        raise ValueError("limit must be a positive integer")
+    path = Path(path)
+    if path.exists():
+        raise FileExistsError(f"{path} already exists")
+    workbook = Workbook()
+    sheet = workbook.active
+    sheet.title = "fizzbuzz"
+    sheet.append(["n", "output"])
+    for n in range(1, limit + 1):
+        sheet.append([n, fizzbuzz(n)])
+    workbook.save(path)
